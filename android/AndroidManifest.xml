<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.julesb40.hookshot.experimental" android:versionCode="4" android:versionName="0.4-layout-bringup">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <uses-feature android:name="android.hardware.vulkan.level" android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <application android:label="Hookshot Android Bring-up" android:allowBackup="false" android:debuggable="true"
        android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name="dev.julesb40.hookshot.MainActivity" android:exported="true"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
